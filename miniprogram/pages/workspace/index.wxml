<view class="page">
 <view class="header"><view><text class="brand">子墨学堂</text><view class="subtitle">让每一次帮助，有记录、有跟进</view></view><button size="mini" bindtap="privacyInfo">隐私说明</button></view>
 <view wx:if="{{demo}}" class="demo">虚构演示 · 与正式数据隔离<view class="muted">身份切换仅在演示环境生效</view><picker range="{{personas}}" value="{{personaIndex}}" bindchange="switchPersona"><view class="select">{{personas[personaIndex]}} ▾</view></picker></view>
 <view wx:if="{{!privacy}}" class="card"><text>开始前请阅读隐私说明。正式使用须由机构完成监护人告知及微信后台隐私配置。</text><button bindtap="privacyInfo">阅读隐私说明</button><button bindtap="acceptPrivacy">已阅读，继续</button></view>
 <view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="refresh">重新加载</button></view>
 <view wx:if="{{notice}}" class="success">{{notice}}</view>
 <view wx:if="{{loading}}" class="card">正在获取最新记录…</view>
 <block wx:if="{{session}}">
 <view class="account">{{session.user.name}} · {{staff ? '机构工作台' : '家长工作台'}}<text class="link" bindtap="register">修改称呼</text></view>
 <view class="muted break">我的账号编号：{{session.user.id}}</view>
 <scroll-view scroll-x class="tabs"><view wx:for="{{tabs}}" wx:key="id" wx:if="{{(staff || item.id === 'today' || item.id === 'scores' || item.id === 'feedback') && (admin || item.id !== 'admin')}}" class="tab {{tab===item.id?'active':''}}" data-id="{{item.id}}" bindtap="tab">{{item.name}}</view></scroll-view>
 <view class="toolbar"><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="select">日期 {{date}} ▾</view></picker><button size="mini" bindtap="refresh">刷新记录</button><button wx:if="{{staff}}" size="mini" bindtap="filter">筛选</button><button wx:if="{{staff}}" size="mini" bindtap="clearFilters">全部</button></view>
 <view wx:if="{{dash}}" class="muted">本次获取：{{dash.updatedAt}}（下拉或点刷新获取最新记录）</view>
 <view wx:if="{{!dash.students.length}}" class="card empty">{{staff?'当前筛选暂无学生，请先由管理员建档。':'暂无已核验绑定的孩子，请向机构索取有效邀请，申请后由机构核验。'}}<button bindtap="claim">输入邀请并申请绑定</button></view>
 <scroll-view scroll-x class="children"><view wx:for="{{dash.students}}" wx:key="id" class="child {{selectedId===item.id?'chosen':''}}" bindtap="selectStudent" data-id="{{item.id}}">{{item.name}}<view class="muted">{{item.className}}</view></view></scroll-view>
 <block wx:if="{{tab==='today'}}">
  <block wx:if="{{staff}}">
   <view class="section-title">今日学生 <text>{{dash.students.length}} 位</text></view>
   <view wx:for="{{dash.students}}" wx:key="id" class="card" bindtap="selectStudent" data-id="{{item.id}}"><view class="row"><text class="strong">{{item.name}}</text><text class="badge">{{item.attendance}}</text></view><view class="muted">{{item.schoolName}} · {{item.className}}</view><view class="row progress"><view wx:for="{{item.daily}}" wx:for-item="s" wx:key="subject"><text>{{s.subject}}</text><view class="muted">{{s.text}}</view></view></view></view>
   <view class="section-title">持续待办</view><view class="card"><view>待检查 {{dash.todoCounts.check}} · 待讲解 {{dash.todoCounts.help}} · 待复核 {{dash.todoCounts.review}} · 作业遗留 {{dash.todoCounts.left}}</view><view>到期／逾期错题 {{dash.due.length}} · 遗留事项 {{dash.handoffs.length}} · 家长沟通 {{dash.communications.length}}</view><view class="muted">选中学生后可在下方检查任务，在“反馈与跟进”处理复查和交接。未完成待办不会因跨日消失。</view><view wx:for="{{dash.due}}" wx:key="id" class="list-row" data-id="{{item.studentId}}" bindtap="selectStudent">复查 {{item.knowledge}} · 截止 {{item.reviewDate}}</view><view wx:for="{{dash.handoffs}}" wx:key="id" class="list-row">交接：{{item.issue}} · {{item.dueDate}}</view></view>
  </block>
  <block wx:if="{{detail}}">
   <view class="section-title">{{detail.student.name}} · {{detail.currentAttendance.status}}</view><view class="muted">到店 {{detail.currentAttendance.arrivedAt || '尚未记录'}}　离店 {{detail.currentAttendance.leftAt || '尚未记录'}}</view><button wx:if="{{staff}}" size="mini" bindtap="attendance">记录到店 / 离店 / 请假</button>
   <view class="section-title">当天三科任务</view><view wx:if="{{!detail.dailyTasks.length}}" class="card empty">待核实：尚未录入共同作业，不能据此认定没有作业。</view>
   <view wx:for="{{detail.dailyTasks}}" wx:key="id" class="card"><view class="row"><text class="strong">{{item.subject}}</text><text class="badge">{{item.status}}</text></view><view class="pre">{{item.content}}</view><view class="muted">来源：{{item.source}}</view><view wx:if="{{item.exception}}" class="tag">个人例外：{{item.exception}}</view><view wx:if="{{item.help}}" class="warning">需要帮助</view><view wx:if="{{item.note}}">{{item.note}}</view><view class="muted">最后更新：{{item.updatedAt || '尚未更新'}}</view><button wx:if="{{staff && !item.missing}}" size="mini" data-id="{{item.id}}" bindtap="taskEdit">记录进度 / 检查 / 复核</button></view>
   <view class="muted">已写完为“待检查”；“检查通过”和“订正已复核”均不代表长期掌握。</view>
   <view class="section-title">已发布当日反馈</view><view wx:if="{{!detail.todayFeedback.length}}" class="card empty">主责老师尚未发布当天反馈，进度可先查看。</view><view wx:for="{{detail.todayFeedback}}" wx:key="id" class="card"><view class="pre">{{item.text}}</view><view class="muted">发布于 {{item.publishedAt}}</view><button size="mini" data-id="{{item.id}}" bindtap="read">标记已阅</button></view>
   <view class="section-title">本周学习目标和重点跟进</view><view wx:if="{{!detail.activeGoals.length}}" class="card empty">尚未记录本周目标</view><view wx:for="{{detail.activeGoals}}" wx:key="id" class="card">{{item.goal}}<view class="muted">{{item.date}} 至 {{item.endDate}}</view></view><view wx:for="{{detail.mistakes}}" wx:key="id" wx:if="{{!item.closed}}" class="card"><text class="strong">{{item.knowledge}}</text><view>发现：{{item.symptom}}</view><view>帮助：{{item.support}}</view><view>当日验证：{{item.result}}</view><view>下一次复查：{{item.reviewDate}}</view><view class="muted">负责人编号：{{item.ownerId}} · {{item.closed?'已结束':'跟进中'}}</view></view>
   <block wx:if="{{!staff}}"><view class="section-title">各科成绩曲线</view><template is="scores" data="{{subject,subjects,subjectIndex,scoreTypes,scoreTypeIndex,scoreType,rangeStart,rangeEnd,scoreRows}}"/><view class="section-title">历史反馈与复查</view><view wx:for="{{detail.historyFeedback}}" wx:key="id" class="card"><text>{{item.date}} · {{item.kind==='weekly'?'周反馈':'日报'}}</text><view class="pre">{{item.text}}</view><button size="mini" data-id="{{item.id}}" bindtap="read">标记已阅</button></view><view wx:for="{{detail.reviews}}" wx:key="id" class="card">{{item.date}} {{item.result}}<view>{{item.note}}</view></view><button bindtap="communicate">需要沟通</button><button bindtap="claim">绑定另一个孩子</button><button bindtap="exportData">导出孩子学习记录（JSON）</button></block>
  </block>
 </block>
 <block wx:if="{{tab==='homework' && staff}}">
  <view class="card"><text class="strong">录入一次，分发同班孩子</text><view class="muted">先勾选学生。班级、日期、科目和来源在发布表中核对；混选班级会由服务器拒绝。</view><button size="mini" bindtap="selectPresent">选择今天已到店学生</button><view wx:for="{{dash.students}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="selectBatch"><text>{{item.selected?'☑':'□'}} {{item.name}} · {{item.schoolName}} {{item.className}} · {{item.attendance}}</text></view><view>已选 {{selectedStudents.length}} 位</view><button bindtap="publishHomework">新增共同作业并分发</button></view>
  <view wx:for="{{dash.homework}}" wx:key="id" class="card"><view>{{item.date}} {{item.subject}} · 第 {{item.revision}} 版</view><view class="pre">{{item.content}}</view><view class="muted">来源：{{item.source}} · {{item.verified?'已核实':'待核实'}}</view><button size="mini" data-id="{{item.id}}" bindtap="publishHomework">复制后修改发布</button><button size="mini" data-id="{{item.id}}" bindtap="reviseHomework">修改共同内容（保留进度）</button></view>
 </block>
 <block wx:if="{{tab==='student' && detail}}">
  <view class="card"><text class="strong">{{detail.student.name}}</text><view>学生编号：{{detail.student.number}}</view><view>学年：{{detail.student.schoolYear}} · 年级：{{detail.student.grade}}</view><view>学校 / 班级 / 分组编号：{{detail.student.schoolId}} / {{detail.student.classId}} / {{detail.student.groupId}}</view><view>主责老师编号：{{detail.student.leadId}}</view><view>{{detail.student.active?'在读':'停读'}}</view><button wx:if="{{admin}}" data-table="students" data-id="{{selectedId}}" bindtap="adminAdd">编辑档案 / 升级转班</button><button wx:if="{{staff}}" bindtap="contacts">重要异常：联系已核验监护人</button><button bindtap="exportData">导出该孩子的 JSON 记录</button></view>
  <view wx:if="{{staff}}" class="card"><text class="strong">监护人绑定</text><button bindtap="createInvite">生成24小时一次性邀请</button><view class="muted">先核实监护关系，再核验申请；邀请码本身不提供查看权限。</view><view wx:for="{{detail.bindings}}" wx:key="id" class="list-row"><view>{{item.relationship}} · {{item.verified && item.active?'已核验有效':'未生效 / 已撤销'}}</view><view class="muted break">申请人编号：{{item.userId}}</view><button size="mini" data-id="{{item.id}}" bindtap="verify">机构核验</button><button wx:if="{{item.active}}" size="mini" data-id="{{item.id}}" bindtap="revoke">撤销绑定</button></view></view>
 </block>
 <block wx:if="{{tab==='scores' && detail}}"><view class="section-title">{{detail.student.name}} · 各科考试记录</view><button wx:if="{{staff}}" bindtap="addScore">录入考试成绩</button><template is="scores" data="{{subject,subjects,subjectIndex,scoreTypes,scoreTypeIndex,scoreType,rangeStart,rangeEnd,scoreRows}}"/></block>
 <block wx:if="{{tab==='feedback' && detail}}">
  <view class="toolbar" wx:if="{{staff}}"><button size="mini" bindtap="addMistake">重点错题</button><button size="mini" bindtap="goal">本周目标</button><button size="mini" bindtap="handoff">遗留交接</button><button size="mini" bindtap="progress">具体进步</button><button size="mini" bindtap="emotion">状态支持</button><button size="mini" bindtap="draft" data-kind="daily">汇总日报草稿</button><button size="mini" bindtap="draft" data-kind="weekly">汇总近7日周反馈</button></view>
  <view class="section-title">重点问题跟进卡</view><view wx:if="{{!detail.mistakes.length}}" class="card empty">尚无重点问题记录</view><view wx:for="{{detail.mistakes}}" wx:key="id" class="card"><view class="strong">{{item.subject}} · {{item.knowledge}}</view><view>题目位置：{{item.location}}</view><view>发现：{{item.symptom}}</view><view>帮助：{{item.support}}</view><view>当日验证：{{item.result}}</view><view>后续结果：{{item.lastResult || '尚未复查'}}</view><view class="warning">{{item.closed?'已结束本轮跟进':'待复查'}} · {{item.reviewDate}}</view><view class="muted break">负责人：{{item.ownerId}}</view><button wx:if="{{staff && !item.closed}}" size="mini" data-id="{{item.id}}" bindtap="review">记录复查</button><button wx:if="{{item.fileId}}" size="mini" data-id="{{item.fileId}}" bindtap="viewFile">鉴权查看图片</button></view>
  <view class="section-title">日报与周反馈</view><view wx:if="{{!detail.feedback.length}}" class="card empty">尚无反馈</view><view wx:for="{{detail.feedback}}" wx:key="id" class="card"><view>{{item.date}} {{item.kind==='weekly'?'周反馈':'日报'}} <text class="badge">{{item.published?'已发布':'草稿·家长不可见'}}</text></view><view class="pre">{{item.text}}</view><button wx:if="{{staff && !item.published}}" size="mini" data-id="{{item.id}}" bindtap="publishFeedback">编辑并确认发布</button><button wx:if="{{item.published}}" size="mini" data-id="{{item.id}}" bindtap="read">标记已阅</button></view>
  <view class="section-title">具体进步（关联真实复查证据）</view><view wx:for="{{detail.progress}}" wx:key="id" class="card">{{item.text}}<view class="muted break">证据：{{item.beforeId}} → {{item.afterId}}</view></view>
  <view class="section-title">遗留事项</view><view wx:for="{{detail.handoffs}}" wx:key="id" class="card"><view>{{item.issue}} · {{item.closed?'已处理':'待处理'}}</view><view>原因：{{item.reason}}</view><view>下一步：{{item.next}} · {{item.dueDate}}</view><view class="muted break">负责人：{{item.ownerId}}</view><view>{{item.result}}</view><button wx:if="{{staff && !item.closed}}" size="mini" data-id="{{item.id}}" bindtap="handoffClose">记录处理结果</button></view>
  <view class="section-title">家长沟通跟进</view><button bindtap="communicate">提交需要沟通</button><view wx:for="{{detail.communications}}" wx:key="id" class="card"><view>{{item.text}}</view><view>{{item.closed?'已处理':'主责老师待处理'}} · {{item.result}}</view><button wx:if="{{staff && !item.closed}}" size="mini" data-id="{{item.id}}" bindtap="closeCommunication">记录沟通处理结果</button></view>
  <view class="section-title">复查历史（不等同于长期掌握）</view><view wx:for="{{detail.reviews}}" wx:key="id" class="card">{{item.date}} {{item.result}}<view>{{item.note}}</view></view>
  <block wx:if="{{staff}}"><view class="section-title">内部状态观察 · 家长无权读取</view><view wx:for="{{detail.emotions}}" wx:key="id" class="card"><view>{{item.date}} · {{item.internal}}</view><view class="muted">家长说明参考：{{item.parentText}}</view></view></block>
 </block>
 <block wx:if="{{tab==='admin' && admin}}"><view class="card"><text class="strong">基础设置顺序</text><view>学校 → 学校班级 → 机构分组 → 员工授权 → 学生建档。转班只更新当前档案，历史作业和成绩保留原班级快照。</view><view class="toolbar"><button data-table="schools" bindtap="adminAdd">新增学校</button><button data-table="classes" bindtap="adminAdd">新增学校班级</button><button data-table="groups" bindtap="adminAdd">新增机构分组</button><button data-table="students" bindtap="adminAdd">新增学生</button><button bindtap="authorize">授权已登录员工</button></view></view><view class="section-title">现有老师</view><view wx:for="{{dash.teachers}}" wx:key="id" class="card"><view>{{item.name}} · {{item.roles}}</view><view class="muted break">{{item.id}}</view><button size="mini" data-table="users" data-id="{{item.id}}" bindtap="adminAdd">修改职责 / 停用</button></view><view class="section-title">学校、班级与机构分组</view><view class="card"><view wx:for="{{dash.schools}}" wx:key="id">学校：{{item.name}}</view><view wx:for="{{dash.classes}}" wx:key="id">学校班级：{{item.schoolYear}} / {{item.name}}</view><view wx:for="{{dash.groups}}" wx:key="id">机构分组：{{item.name}}</view></view></block>
 <view class="footer">进度需刷新获取；详细反馈以老师发布为准。<view>订阅消息尚未接入，重要事项请直接联系监护人。</view></view>
 </block>
</view>
<view wx:if="{{form}}" class="modal"><scroll-view scroll-y class="form"><view class="section-title">{{form.title}}</view><view wx:for="{{form.fields}}" wx:key="key" class="field"><view class="label">{{item.name}}</view><textarea wx:if="{{item.type==='textarea'}}" value="{{item.value}}" auto-height maxlength="6000" data-index="{{index}}" bindinput="fieldInput" placeholder="请填写具体事实"/><picker wx:elif="{{item.type==='select'}}" range="{{item.options}}" range-key="label" bindchange="fieldPick" data-index="{{index}}"><view class="select">{{item.label || item.value || '请选择'}} ▾</view></picker><picker wx:elif="{{item.type==='date'}}" mode="date" value="{{item.value}}" bindchange="fieldInput" data-index="{{index}}"><view class="select">{{item.value || '选择日期'}} ▾</view></picker><switch wx:elif="{{item.type==='switch'}}" checked="{{item.value}}" color="#28785a" data-index="{{index}}" bindchange="fieldSwitch"/><input wx:else type="{{item.type==='number'?'digit':'text'}}" value="{{item.value}}" data-index="{{index}}" bindinput="fieldInput" maxlength="2000" placeholder="请填写"/></view><button wx:if="{{form.action==='mistakeSave'}}" bindtap="upload" disabled="{{saving}}">上传题目照片（JPEG/PNG，≤500KB）</button><view wx:if="{{formError}}" class="error">保存未成功：{{formError}}</view><view class="toolbar"><button bindtap="cancelForm" disabled="{{saving}}">取消</button><button class="primary" bindtap="saveClick" loading="{{saving}}" disabled="{{saving}}">{{saving?'正在保存':'核对并保存'}}</button></view><view class="muted">未出现成功提示时，请保留输入并重试；同一请求会去重。</view></scroll-view></view>
<template name="scores"><view class="card"><view class="toolbar"><picker range="{{subjects}}" value="{{subjectIndex}}" bindchange="scoreSubject"><view class="select">{{subject}} ▾</view></picker><picker range="{{scoreTypes}}" value="{{scoreTypeIndex}}" bindchange="scoreFilter"><view class="select">{{scoreType}} ▾</view></picker><picker mode="date" data-key="rangeStart" bindchange="scoreRange"><view class="select">{{rangeStart || '开始日期'}}</view></picker><picker mode="date" data-key="rangeEnd" bindchange="scoreRange"><view class="select">{{rangeEnd || '结束日期'}}</view></picker></view><view class="muted">纵轴：得分 ÷ 满分（%）；横轴：考试日期。换算不代表考试难度相同；缺失不计零分。</view><canvas id="scoreChart" canvas-id="scoreChart" class="chart" width="320" height="210" bindtouchstart="chartTap"/><view wx:if="{{!scoreRows.length}}" class="empty">该条件下暂无成绩，不生成趋势结论。</view><view wx:for="{{scoreRows}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="scoreDetail"><view>{{item.date}} · {{item.name}} · {{item.type}}</view><view class="strong">{{item.score}} / {{item.full}}</view><view class="muted">来源：{{item.source}} · {{item.verified?'已核验':'待核验'}}　点按查看详情</view></view></view></template>
