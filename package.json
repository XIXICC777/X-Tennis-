{
  "name": "zimo-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npm run build && node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p miniprogram/tsconfig.json && node scripts/verify-miniprogram.js",
    "demo": "node scripts/demo-server.js",
    "check:demo": "node scripts/check-demo.js",
    "predemo": "npm run build",
    "check:bundle": "node scripts/verify-miniprogram.js"
  },
  "devDependencies": {
    "miniprogram-api-typings": "4.0.8",
    "miniprogram-compiler": "0.2.3",
    "typescript": "5.9.3",
    "wx-server-sdk": "3.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
